{
  "file_types": {
    "JSON": [".luaurc"],
  },
  "format_on_save": "on",
  "lsp": {
    "luau-lsp": {
      "settings": {
        "fflags": {
          "enable_new_solver": true,
        },
      },
    },
  },
  "languages": {
    "Luau": {
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--stdin-filepath", "{buffer_path}", "-"],
        },
      },
    },
  },
}
